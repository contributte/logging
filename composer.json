{
  "name": "contributte/logging",
  "description": "Plug-in support logging for Tracy / Nette Framework",
  "keywords": [
    "nette",
    "logging",
    "tracy",
    "monolog",
    "plugins"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/contributte/logging",
  "authors": [
    {
      "name": "Milan Felix Šulc",
      "homepage": "https://f3l1x.io"
    }
  ],
  "require": {
    "php": ">=8.2",
    "tracy/tracy": "^2.11.0"
  },
  "require-dev": {
    "contributte/phpstan": "~0.2.0",
    "contributte/qa": "~0.4.0",
    "contributte/tester": "~0.3.0",
    "nette/di": "^3.2.0",
    "sentry/sdk": "^4.0.0"
  },
  "conflict": {
    "nette/di": "<3.0"
  },
  "suggest": {
    "nette/di": "to use TracyLoggingExtension",
    "sentry/sdk": "to use SentryLoggingExtension"
  },
  "autoload": {
    "psr-4": {
      "Contributte\\Logging\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-master": "0.6.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
