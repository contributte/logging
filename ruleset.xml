<?xml version="1.0"?>
<ruleset name="Contributte">
	<!-- Contributte Coding Standard -->
	<rule ref="./vendor/contributte/qa/ruleset-8.2.xml"/>

	<!-- Specific rules -->
	<rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
		<properties>
			<property name="rootNamespaces" type="array">
				<element key="src" value="Contributte\Logging"/>
				<element key="tests" value="Tests"/>
			</property>
		</properties>
	</rule>

	<!-- Allow $_SERVER in Mailer classes for HTTP_HOST detection -->
	<rule ref="SlevomatCodingStandard.Variables.DisallowSuperGlobalVariable.DisallowedSuperGlobalVariable">
		<exclude-pattern>/src/Mailer/</exclude-pattern>
	</rule>

	<!-- Exclude folders -->
	<exclude-pattern>/tests/tmp</exclude-pattern>
</ruleset>
